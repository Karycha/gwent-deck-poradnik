{
  "name": "warsztat-gwinta",
  "version": "1.1.0",
  "description": "Warsztat Gwinta: kolekcja, decki, zadania i dziennik meczów Gwinta",
  "productName": "Warsztat Gwinta",
  "author": "Karycha",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --publish never" },
  "dependencies": { "electron-updater": "6.3.9" },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" },
  "build": {
    "appId": "pl.karys.warsztatgwinta",
    "productName": "Warsztat Gwinta",
    "artifactName": "Warsztat-Gwinta-Setup-${version}.${ext}",
    "files": ["main.js", "preload.js", "logparser.js", "quest-defs.json", "icon.png", "app/**"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "shortcutName": "Warsztat Gwinta" },
    "publish": [{ "provider": "github", "owner": "Karycha", "repo": "gwent-deck-poradnik", "releaseType": "release" }]
  }
}
